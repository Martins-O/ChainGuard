# ─────────────────────────────────────────────────────────────────────────────
# ChainGuard - Production Environment Template
# Copy to .env and fill in all required values before deploying
# ─────────────────────────────────────────────────────────────────────────────

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Option A: Self-hosted (docker-compose mongodb service)
MONGODB_URL=mongodb://chainguard:CHANGE_ME@mongodb:27017/chainguard

# Option B: MongoDB Atlas
# MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/chainguard

MONGO_ROOT_USER=chainguard
MONGO_ROOT_PASSWORD=CHANGE_ME

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
THREAT_THRESHOLD=70
MODEL_PATH=/app/models

# ─── Notifications — Slack ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Notifications — Discord ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Notifications — Email (SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=
ALERT_EMAIL_RECIPIENTS=security@yourdomain.com
EMAIL_FROM=alerts@yourdomain.com

# ─── Notifications — Email (SMTP alternative) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Notifications — SMS (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_RECIPIENTS=

# ─── Avalanche Ingestion ────────────────────────────────────────────────────
AVALANCHE_WS_URL=wss://api.avax.network/ext/bc/C/ws
FALLBACK_WS_URLS=wss://avalanche-c-chain.publicnode.com/ws,wss://avax.public-rpc.com/ext/bc/C/ws

# ─── Monitoring ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
GRAFANA_PASSWORD=CHANGE_ME
