# Environment Variables Template
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://chainguard:chainguard_password@localhost:5432/chainguard

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Notification Services

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Email (SendGrid)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
ALERT_EMAIL_RECIPIENTS=admin@example.com,security@example.com
EMAIL_FROM=alerts@chainguard.example.com

# Email (SMTP alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_RECIPIENTS=+1234567890,+0987654321

# AI Engine Configuration
THREAT_THRESHOLD=70
MODEL_PATH=./models

# Ingestion Configuration
AVALANCHE_WS_URL=wss://api.avax.network/ext/bc/C/ws
FALLBACK_WS_URLS=wss://avalanche-c-chain.publicnode.com/ws,wss://avax.public-rpc.com/ext/bc/C/ws

# Service Ports
API_PORT=3000
AI_ENGINE_PORT=8000
ALERT_SERVICE_PORT=3001
INGESTION_METRICS_PORT=9000

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=production

# Grafana (for monitoring profile)
GRAFANA_PASSWORD=admin

# Optional: Custom RPC Endpoints for different subnets
# CUSTOM_SUBNET_RPC_URL=https://your-custom-subnet.com/rpc
# CUSTOM_SUBNET_WS_URL=wss://your-custom-subnet.com/ws